DATABASE_URL=postgres://app:app@localhost:5432/app

# AI: openrouter | anthropic | openai | openai-compatible
AI_PROVIDER=openrouter
# Model id for the chosen provider (openrouter uses vendor/model)
AI_MODEL=anthropic/claude-sonnet-5.5
# Only for openai-compatible
AI_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Better Auth (optional, app runs without it)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
